rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // OpenGraph preview cards: publicly readable so social crawlers (WhatsApp, Twitter) can fetch them
    match /og_images/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default rule for other user uploads
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // OpenGraph preview cards: publicly readable so social crawlers (WhatsApp, Twitter, Telegram) can fetch them
    match /og_images/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Article Cover Images
    match /covers/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // In-Article Embedded Images
    match /article_images/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User Profile Avatars
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default rule for all other assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
